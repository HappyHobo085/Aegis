# Copy to `.env` and edit, then `docker compose up -d` picks it up.
# Referenced by docker-compose.yml
# (`ports: "${AEGIS_SYNC_BIND:-127.0.0.1}:${AEGIS_SYNC_PORT:-8787}:8787"`).

# Host port to publish the sync server on. The container always listens on 8787.
AEGIS_SYNC_PORT=8787

# Address the published port binds to on the HOST. Defaults to 127.0.0.1 (loopback),
# which keeps the plain-HTTP, no-transport-auth sync endpoint off the network. Change
# it only to reach the server from another machine — and then only with a TLS reverse
# proxy in front of it (see DOCKER.md, "Exposing it to another machine").
# AEGIS_SYNC_BIND=0.0.0.0

# Shared secret needed to create a NEW account on this server (users type it into
# Aegis's Settings → Sync → "Server registration code"). Strongly recommended for any
# server reachable by people you don't control: without it, anyone who can reach the
# server can create accounts on it (bounded only by the server-wide caps). Joining an
# EXISTING account never uses it — the account's first device approves new devices.
# AEGIS_SYNC_REGISTRATION_SECRET=
