{
  "name": "aegis",
  "version": "0.1.0",
  "description": "Aegis — a Tauri ad-blocking browser shell",
  "author": "HappyHobo085",
  "repository": {
    "type": "git",
    "url": "https://github.com/HappyHobo085/Aegis.git"
  },
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=1 tauri build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.477.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^25.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
