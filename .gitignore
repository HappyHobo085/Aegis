node_modules/
dist/
*.log
.DS_Store
.env

# Coverage REPORT output (text/lcov/json). Generated by `npm run test:coverage`.
# The committed `coverage-baseline.json` is a different thing and IS tracked — it is
# the ratchet the CI gate compares against. Same for
# `src-tauri/coverage-baseline.json`, the Rust half of the same gate.
coverage/

# Local data backups produced by the in-app Export (default filename); personal data
aegis-export.json

# Cargo build dirs. `tauri build` and the cross-compile helper can put a target dir
# at the repo root; src-tauri/target is ignored by src-tauri/.gitignore. (There is no
# autopilot run-output dir to ignore here: the whole `src/autopilot/` harness was
# deleted in 8b2b461 along with the `scripts/autopilot/run-autopilot.sh` launcher this
# comment used to name, so there is nothing left for this file to ignore.)
/target/
