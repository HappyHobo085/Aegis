  },
  {
    "name": "devices_pending_self_remove_403",
    "given": {
      "accounts": [["{{acct:A}}", {
        "devices": [
          { "device_id": "{{dev:D1}}", "label": "phone", "registered_ms": 1000 },
          { "device_id": "{{dev:D2}}", "label": "laptop", "registered_ms": 2000 }
