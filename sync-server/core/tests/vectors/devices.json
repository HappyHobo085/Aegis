  {
    "name": "devices_owner_never_pending_ranks_first",
    "given": {
      "accounts": [["{{acct:A}}", {
        "devices": [
          { "device_id": "{{dev:D1}}", "label": "phone", "registered_ms": 2000 },
          { "device_id": "{{dev:D2}}", "label": "laptop", "registered_ms": 1000 }
        ],
        "pending": ["{{dev:D2}}"],
        "approved": ["{{dev:D2}}"]
      }]]
    },
    "request": {
      "method": "GET",
      "path": "/v1/devices",
      "headers": [["authorization", "{{auth:A:D2:01}}"]]
