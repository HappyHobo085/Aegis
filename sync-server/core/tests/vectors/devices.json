        },
        "expect": {
          "status": 200,
          "body_subset": {
            "devices": [{ "deviceId": "{{dev:D2}}" }, { "deviceId": "{{dev:D3}}" }],
            "pending": [],
            "ownerDeviceId": "{{dev:D3}}"
          }
        }
      },
      {
        "request": {
          "method": "POST",
          "path": "/v1/devices/remove",
          "headers": [["authorization", "{{auth:A:D3:02}}"]],
          "body": { "deviceId": "{{dev:D2}}" }
