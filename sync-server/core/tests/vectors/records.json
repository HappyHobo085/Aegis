[
  {
    "name": "records_push_then_get",
    "given": {
      "accounts": [["{{acct:A}}", { "devices": [{ "device_id": "{{dev:D1}}", "label": "phone", "registered_ms": 1000 }] }]]
    },
    "request": {
      "method": "POST",
      "path": "/v1/records",
      "headers": [["authorization", "{{auth:A:D1:01}}"]],
      "body": {
        "ns": "bm",
        "records": [
          { "uuid": "u2", "hlc": { "wall_ms": 1000, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a2", "ct": "c2" },
          { "uuid": "u1", "hlc": { "wall_ms": 1001, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a1", "ct": "c1" }
        ]
      }
    },
    "expect": { "status": 200, "body": { "ok": true } },
    "then": [
      {
        "request": {
          "method": "GET",
          "path": "/v1/records?ns=bm",
          "headers": [["authorization", "{{auth:A:D1:02}}"]]
        },
        "expect": {
          "status": 200,
          "body": {
            "records": [
              { "uuid": "u1", "hlc": { "wall_ms": 1001, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a1", "ct": "c1" },
              { "uuid": "u2", "hlc": { "wall_ms": 1000, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a2", "ct": "c2" }
            ],
            "next": null
          }
        }
      },
      {
        "request": {
          "method": "GET",
          "path": "/v1/records?ns=other",
          "headers": [["authorization", "{{auth:A:D1:03}}"]]
        },
        "expect": { "status": 200, "body": { "records": [], "next": null } }
      }
    ]
  },
  {
    "name": "records_stale_push_loses",
    "given": {
      "accounts": [["{{acct:A}}", { "devices": [{ "device_id": "{{dev:D1}}", "label": "phone", "registered_ms": 1000 }] }]],
      "records": [["{{acct:A}}", "bm", { "uuid": "u1", "hlc": { "wall_ms": 2000, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a2", "ct": "new" }]]
    },
    "request": {
      "method": "POST",
      "path": "/v1/records",
      "headers": [["authorization", "{{auth:A:D1:01}}"]],
      "body": {
        "ns": "bm",
        "records": [{ "uuid": "u1", "hlc": { "wall_ms": 1000, "counter": 5, "node": "n9" }, "deleted": false, "nonce": "a1", "ct": "old" }]
      }
    },
    "expect": { "status": 200, "body": { "ok": true } },
    "then": [
      {
        "request": {
          "method": "GET",
          "path": "/v1/records?ns=bm",
          "headers": [["authorization", "{{auth:A:D1:02}}"]]
        },
        "expect": {
          "status": 200,
          "body": {
            "records": [{ "uuid": "u1", "hlc": { "wall_ms": 2000, "counter": 0, "node": "n1" }, "deleted": false, "nonce": "a2", "ct": "new" }],
            "next": null
          }
        }
      }
    ]
  },
