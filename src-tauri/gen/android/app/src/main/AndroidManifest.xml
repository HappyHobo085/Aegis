<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The device-level half of the site-permission prompt. The web prompt in the
         chrome asks "does this SITE get the camera?"; these are the separate
         app-wide grants the platform asks about, which `MainActivity` requests the
         moment a web request is granted (see requestAndroidPermissionFor). Without
         them a granted web request still fails: getUserMedia and geolocation both
         require the app itself to hold the permission. All four are OPTIONAL
         (uses-feature required="false" below) so the app still installs on a device
         with no camera, no microphone or no location provider. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Backup is a PRIVACY requirement, not a default, and it is enforced by TWO
         mechanisms because no single one covers both transports.

         What is at stake: every store is UNENCRYPTED JSON on disk (history.json,
         favorites.json, saved.json, allowlist.json, settings.json, customFilters) plus
         vault.json and the wrapped sync-root blobs — exactly the data this product exists
         to keep on the user's own device. Sync is the ONLY sanctioned way for it to move
         between a user's own devices, and that goes through this app's own encrypted
         protocol, not a platform backup.

         android:allowBackup="false" (on <application> below) handles the pre-31 CLOUD path.
         It is deliberately NOT the whole answer on its own: Google documents that "for apps
         targeting Android 12 (API level 31) or higher, this behavior varies. On devices from
         some device manufacturers, specifying android:allowBackup="false" disables
         cloud-based backup and restore (such as Google Drive backups) but doesn't disable
         device-to-device transfers for the app." targetSdk here is 36, so on part of the
         fleet the D2D transfer stayed live while the manifest claimed otherwise.

         android:dataExtractionRules (added below, pointing at res/xml/data_extraction_rules.xml)
         is the mechanism that does not vary by manufacturer: it governs BOTH cloud backup and
         device-to-device transfer on API 31+, and that file excludes every documented domain
         under <cloud-backup>, <device-transfer> and <cross-platform-transfer>. Its own header
         comment records why each of those three sections is spelled out even though an absent
         section would be a fully ENABLED one.

         There is deliberately no android:fullBackupContent: that older format is what
         Android 11 and lower read, where allowBackup="false" already covers it, and it has no
         effect on D2D transfers on API 31+ — a file that looks protective while governing
         nothing would be worse than none. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- configChanges also covers fontScale / density / layoutDirection / colorMode:
             the platform default RECREATES the Activity on those, and every tab WebView
             pins this Activity's context + a renderer process, so a system font-size
             change used to destroy the whole browsing session. Handling them in-process
             keeps the tabs alive (the chrome and content webviews pick up the new density
             on their own next layout). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density|layoutDirection|colorMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
