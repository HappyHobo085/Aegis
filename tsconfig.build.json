{
  // This is the config CI type-checks, so it deliberately covers the WHOLE type surface —
  // tests and test fixtures included. It used to exclude `**/*.test.ts(x)` and
  // `src/testFixtures`, which meant the gate never saw the ~950 test files or the mock
  // every one of them runs against. That hid real drift: a `TabMeta` fixture missing the
  // `workspaceId` the workspaces feature added, an `AutopilotControl` mock missing
  // `setOmnibox`, and an untyped `aegisMock.ts` that had fallen behind `AegisApi` — all
  // invisible to CI, all trivially fixable once visible. The exclude list is now only the
  // build-output directories. Keep it that way: a test-only type error is a real error.
  "extends": "./tsconfig.json",
  // The Vite/Vitest configs are typechecked too: they are build tooling, and an
  // invalid plugin option in one is invisible until someone notices the transform is a
  // no-op. A stale `react({ babel: ... })` in there shipped as dead config for a while
  // precisely because nothing ever compiled it — see `vite.shared.ts`.
  "include": ["src", "shared", "vite.config.ts", "vitest.config.ts", "vite.shared.ts"],
  "exclude": ["node_modules", "out", "dist"]
  // DEFERRED, deliberately — do not re-litigate without measuring first.
  //
  // `noUncheckedIndexedAccess` is the one that matters and it is NOT cheap: this tree
  // indexes arrays/maps constantly (tab lists, record maps, split paths), so enabling
  // it types every element access as `T | undefined` and lands a large error count
  // across the app AND the ~950 test files this config now covers. It wants its own
  // pass with the non-null assertions (or `at()`/`??` defaults) chosen deliberately
  // per site, not a flag flip.
  //
  // `exactOptionalPropertyTypes` is close behind: the IPC payloads and store rows use
  // `field?: T` to mean "absent", and this flag reinterprets that as "absent or
  // explicitly undefined", which is a different wire contract for `shared/types.ts`.
  //
  // `noImplicitOverride` and `noFallthroughCasesInSwitch` are cheap and could be added
  // on their own; `noUnusedLocals`/`noUnusedParameters` are deliberately NOT taken from
  // tsc because the ESLint side (`@typescript-eslint/no-unused-vars`) owns unused-code
  // detection here — see the measured backlog in eslint.config.mjs.
}
