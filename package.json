{
  "name": "aegis",
  "version": "0.1.0",
  "description": "Aegis — a Tauri ad-blocking browser shell",
  "author": "HappyHobo085",
  "repository": {
    "type": "git",
    "url": "https://github.com/HappyHobo085/Aegis.git"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.29.1",
    "nanoid": "^3.3.18"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=1 tauri build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:baseline": "node scripts/coverage-baseline.mjs",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "coverage:rust:baseline": "node scripts/rust-coverage-baseline.mjs",
    "coverage:rust:ratchet": "node scripts/rust-coverage-ratchet.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true npm run build:renderer",
    "sizecheck": "node scripts/check-bundle-size.mjs",
    "check:android-version": "node scripts/check-android-versioncode.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "lucide-react": "^1.49.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.9",
    "react": "^19",
    "react-dom": "^19",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
