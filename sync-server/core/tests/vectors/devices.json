  {
    "name": "devices_owner_self_remove_handoff",
    "given": {
      "accounts": [["{{acct:A}}", {
        "devices": [
          { "device_id": "{{dev:D1}}", "label": "phone", "registered_ms": 1000 },
          { "device_id": "{{dev:D2}}", "label": "laptop", "registered_ms": 3000 },
          { "device_id": "{{dev:D3}}", "label": "tablet", "registered_ms": 2000 }
        ],
        "pending": ["{{dev:D2}}", "{{dev:D3}}"],
        "approved": ["{{dev:D2}}", "{{dev:D3}}"]
      }]]
    },
    "request": {
      "method": "POST",
      "path": "/v1/devices/remove",
      "headers": [["authorization", "{{auth:A:D1:01}}"]],
      "body": { "deviceId": "{{dev:D1}}" }
    },
    "expect": { "status": 200, "body": { "ok": true } },
    "then": [
      {
        "request": {
          "method": "GET",
          "path": "/v1/devices",
